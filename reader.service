[Unit]
Description=Pembaca Tunanetra (Image to Voice) - GUI TFT
After=multi-user.target sound.target

[Service]
User=raspy
SupplementaryGroups=audio video gpio input
WorkingDirectory=/home/raspy/TA_ANO/tts-ano-ta
Environment=PYTHONUNBUFFERED=1
Environment=OMP_THREAD_LIMIT=1
ExecStart=/home/raspy/TA_ANO/tts-ano-ta/.venv/bin/python main.py --gui
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
