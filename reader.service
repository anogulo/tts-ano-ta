[Unit]
Description=Pembaca Tunanetra (Image to Voice) - GUI TFT
After=multi-user.target sound.target local-fs.target

[Service]
User=raspy
SupplementaryGroups=audio video gpio input render

WorkingDirectory=/home/raspy/TA_ANO/tts-ano-ta

# Pastikan folder logs & assets dimiliki user raspy sebelum start
ExecStartPre=/bin/mkdir -p /home/raspy/TA_ANO/tts-ano-ta/logs
ExecStartPre=/bin/mkdir -p /home/raspy/TA_ANO/tts-ano-ta/assets
ExecStartPre=/bin/chown -R raspy:raspy /home/raspy/TA_ANO/tts-ano-ta/logs
ExecStartPre=/bin/chown -R raspy:raspy /home/raspy/TA_ANO/tts-ano-ta/assets

# Variabel lingkungan penting untuk SDL2 + FramebufferBlitter (tanpa X11)
Environment=PYTHONUNBUFFERED=1
Environment=OMP_THREAD_LIMIT=1
Environment=SDL_VIDEODRIVER=dummy
Environment=SDL_MOUSEDRV=dummy
Environment=SDL_MOUSEDEV=/dev/null
Environment=DISPLAY=
Environment=HOME=/home/raspy

ExecStart=/home/raspy/TA_ANO/tts-ano-ta/.venv/bin/python main.py --gui

Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

